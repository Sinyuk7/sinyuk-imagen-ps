{
  "name": "@imagen-ps/execution-backend-comfyui",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./contract/*": "./contract/*"
  },
  "scripts": {
    "build": "node scripts/generate-contract-runtimes.mjs --check && tsc --project tsconfig.build.json && node scripts/copy-contract-artifacts.mjs",
    "test": "vitest run && node scripts/check-contract-conformance.mjs",
    "contract:generate": "node scripts/generate-contract-runtimes.mjs",
    "contract:check": "node scripts/generate-contract-runtimes.mjs --check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@imagen-ps/core-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
