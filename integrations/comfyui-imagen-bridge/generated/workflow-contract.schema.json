{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagen-ps.local/schemas/comfyui-workflow-contract-v1.json",
  "title": "Imagen ComfyUI Workflow Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding",
    "type"
  ],
  "properties": {
    "binding": {
      "$ref": "#/$defs/bindingContract"
    },
    "type": {
      "$ref": "#/$defs/typeContract"
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "prompt",
        "image",
        "mask",
        "output-image"
      ]
    },
    "dataType": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "mask"
      ]
    },
    "maskEncoding": {
      "type": "string",
      "enum": [
        "grayscale",
        "alpha",
        "inverted-alpha"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "fieldName"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fieldName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "bindingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "slot",
        "locator"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "typeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "slot",
        "required",
        "dataType"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "required": {
          "type": "boolean"
        },
        "dataType": {
          "$ref": "#/$defs/dataType"
        },
        "maskEncoding": {
          "$ref": "#/$defs/maskEncoding"
        }
      }
    },
    "bindingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "bindings"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/bindingEntry"
          }
        }
      }
    },
    "typeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "entries"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "text-to-image",
            "image-edit"
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/typeEntry"
          }
        }
      }
    }
  }
}
